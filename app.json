{
  "expo": {
    "name": "FES 逛展清单",
    "slug": "fes-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "feslist",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cn.fes.boothlist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "选择摊宣图、地图时需要用相册里的图片",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "cn.fes.boothlist",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择摊宣图、地图时需要用相册里的图片"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c9d0d4f-b78d-400a-92c5-ff72d4b14500"
      }
    },
    "owner": "lumineeeeee698"
  }
}
